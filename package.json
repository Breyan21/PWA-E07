{
  "name": "pwa-inspecciones-laboratorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node tests/starter.spec.mjs && npx --yes tsx tests/rendering.spec.ts && npx --yes tsx tests/sync.spec.ts && npx --yes tsx tests/capabilities.spec.ts",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:all": "npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run test:legacy && npm run test:e2e && npm run verify"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^30.1.3",
    "typescript": "^5.4.5",
    "vitest": "^5.0.5"
  }
}
